{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@kit/*": [
        "../../../shared/video-kit/src/*"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
